{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "max_offload_input_chars": {"type": "integer", "minimum": 0, "default": 0, "description": "Maximum tool-output characters sent to the cheap summarizer; zero is unbounded."},
    "expected_applications": {"type": "integer", "minimum": 0, "default": 0, "description": "Expected future uses of the rewritten context; zero disables model compaction."},
    "tool_policies": {"type": "array", "items": {"$ref": "#/$defs/policy"}, "default": [], "description": "Ordered first-match compaction rules."}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "mode"],
      "properties": {
        "match": {"type": "string", "description": "Case-insensitive shell-style tool-name pattern."},
        "mode": {"type": "string", "enum": ["exact", "deterministic", "source", "model"]},
        "first_pass": {"type": "boolean", "default": false},
        "rerun": {"type": "string"}
      }
    }
  }
}
