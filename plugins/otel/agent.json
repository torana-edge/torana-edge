{
  "schema_version": 1,
  "description": "Machine-readable OpenTelemetry plugin operations.",
  "operations": [
    {
      "id": "status",
      "method": "GET",
      "path": "/status",
      "description": "Read the plugin identity and metric-emission readiness.",
      "risk": "read",
      "idempotent": true,
      "output_schema": {
        "type": "object",
        "required": ["plugin", "status", "capabilities"],
        "properties": {
          "plugin": {"const": "otel"},
          "status": {"const": "ready"},
          "capabilities": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
