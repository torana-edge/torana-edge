{
  "schema_version": 1,
  "id": "torana-test/test-fragment-buffer",
  "name": "test-fragment-buffer",
  "version": "0.1.0",
  "abi_version": "v2",
  "minimum_torana_version": "0.1.0",
  "failure_mode": "pass",
  "description": "Test fixture: buffers streamed tool-call argument fragments in request-scoped host state and emits them once complete",
  "hooks": [
    {
      "name": "run_on_stream_chunk"
    }
  ],
  "permissions": [
    {
      "name": "ir.messages.write.assistant",
      "description": "Rewrite assembled streamed tool arguments"
    },
    {
      "name": "ir.stream.write",
      "description": "Suppress fragments and emit an assembled replacement"
    },
    {
      "name": "env.meta_get",
      "description": "read request-scoped fragment buffer"
    },
    {
      "name": "env.meta_set",
      "description": "write request-scoped fragment buffer"
    },
    {
      "name": "env.log",
      "description": "Diagnostic logging"
    }
  ]
}
