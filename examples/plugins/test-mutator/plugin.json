{
  "schema_version": 1,
  "id": "torana-test/test-mutator",
  "name": "test-mutator",
  "version": "0.1.0",
  "abi_version": "v2",
  "minimum_torana_version": "0.1.0",
  "failure_mode": "pass",
  "description": "Test fixture: deterministically rewrites user messages and tool definitions",
  "hooks": [
    {
      "name": "run_before_request"
    },
    {
      "name": "run_after_response"
    }
  ],
  "permissions": [
    {
      "name": "env.log",
      "description": "Diagnostic logging"
    }
  ]
}
