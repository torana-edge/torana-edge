{
  "schema_version": 1,
  "id": "torana-test/test-http-server-nogrant",
  "name": "test-http-server-nogrant",
  "version": "0.1.0",
  "abi_version": "v1",
  "minimum_torana_version": "0.1.0",
  "failure_mode": "pass",
  "description": "Test fixture: HTTP echo without the env.request_headers grant",
  "hooks": [
    {
      "name": "run_on_http_request"
    }
  ],
  "permissions": [
    {
      "name": "env.serve_http",
      "description": "Serve pages and JSON under /_torana/plugin/test-http-server/"
    },
    {
      "name": "env.log",
      "description": "Diagnostic logging"
    },
    {
      "name": "env.cache_get",
      "description": "Deterministic snapshot barrier"
    }
  ]
}
