{
  "schema_version": 2,
  "description": "Test fixture agent operations.",
  "namespace": {
    "title": "Test HTTP server",
    "summary": "Exercise read and reversible write agent operations."
  },
  "operations": [
    {
      "id": "status",
      "method": "GET",
      "path": "/status",
      "description": "Read the fixture's identity, the forwarded method, query, scheme, and caller address.",
      "risk": "read",
      "idempotent": true,
      "output_schema": {
        "type": "object",
        "required": [
          "plugin",
          "status",
          "method",
          "query",
          "scheme",
          "remote_addr",
          "headers"
        ],
        "properties": {
          "plugin": {
            "const": "test-http-server"
          },
          "status": {
            "const": "ready"
          },
          "method": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "scheme": {
            "type": "string"
          },
          "remote_addr": {
            "type": "string"
          },
          "headers": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "value.set",
      "method": "POST",
      "path": "/value",
      "description": "Set the fixture value.",
      "risk": "write",
      "idempotent": true,
      "model_access": "confirm",
      "conversation_binding": "required",
      "undo_operation": "value.set.undo",
      "input_schema": {
        "type": "object",
        "required": ["value"],
        "properties": {"value": {"type": "string"}},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["value"],
        "properties": {"value": {"type": "string"}},
        "additionalProperties": false
      }
    },
    {
      "id": "value.set.undo",
      "method": "POST",
      "path": "/value/undo",
      "description": "Undo the matching fixture value change.",
      "risk": "write",
      "idempotent": true,
      "model_access": "never",
      "conversation_binding": "required",
      "input_schema": {
        "type": "object",
        "required": ["value"],
        "properties": {"value": {"type": "string"}},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["value"],
        "properties": {"value": {"type": "string"}},
        "additionalProperties": false
      }
    }
  ]
}
