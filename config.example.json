{
  "port": 8080,
  "providers": {
    "deepseek": {
      "url": "https://api.deepseek.com",
      "format": "openai",
      "auth": {
        "mode": "caller"
      }
    },
    "deepseek-anthropic": {
      "url": "https://api.deepseek.com/anthropic",
      "format": "anthropic",
      "auth": {
        "mode": "caller"
      }
    },
    "gemini": {
      "url": "https://generativelanguage.googleapis.com",
      "format": "gemini"
    }
  },
  "plugins": {
    "dir": "./plugins",
    "order": []
  },
  "limits": {
    "concurrency": 10,
    "rpm": 100
  }
}
